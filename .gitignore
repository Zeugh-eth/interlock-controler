# Whitelist repo, created 23 Oct 2026 to register the arm-daemon agent-layer changes so they can be
# reverted file by file (git log / git checkout <commit> -- <path>). Everything is ignored except
# the code, tests, skill text and calibration JSON listed below; demos, weights, venvs, photos and
# vendor trees stay out of git.
*
!.gitignore
!arm-daemon/
arm-daemon/*
!arm-daemon/*.py
!arm-daemon/*.md
!arm-daemon/pytest.ini
!arm-daemon/dashboard.html
!arm-daemon/dashboard_menus.html
!arm-daemon/mcp-http.command
!arm-daemon/brand/
!arm-daemon/brand/*
!arm-daemon/brand/png/
!arm-daemon/brand/png/*
**/.DS_Store
!arm-daemon/tests/
arm-daemon/tests/*
!arm-daemon/tests/*.py
!arm-daemon/tests/data/
arm-daemon/tests/data/*
!arm-daemon/tests/data/*.jpg
!.claude/
.claude/*
!.claude/skills/
!.claude/skills/**
!lab/
lab/*
!lab/arm-vision/
lab/arm-vision/*
!lab/arm-vision/*.json
!reports/
reports/*
!reports/robot-ai-practices/
reports/robot-ai-practices/*
!reports/robot-ai-practices/*.html
!docs/
docs/*
!docs/superpowers/
!docs/superpowers/**
!docs/*.md
!README.md
!LICENSE
# runtime pieces of Interlock Core / Link / Console (added for the public repo)
!arm-daemon/*.command
!arm-daemon/smoke.sh
!arm-daemon/static/
!arm-daemon/static/**
!arm-daemon/brand/
!arm-daemon/brand/**
!scripts/
scripts/*
!scripts/kin.py
!scripts/camcal.py
!scripts/arm-go.py
!scripts/grasp.py
!scripts/posture.py
!scripts/vision.py
!scripts/cam-server.py
!scripts/cam-server.command
!vendor/
vendor/*
!vendor/so101/
!vendor/so101/**
!tools/
tools/*
!tools/arm-lerobot/
tools/arm-lerobot/*
!tools/arm-lerobot/pyproject.toml
!tools/arm-lerobot/uv.lock
!tools/models/
tools/models/*
!tools/models/yolov8s-worldv2.pt
!lab/calibration/
!lab/calibration/*.json
